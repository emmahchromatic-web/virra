# Copy this file to `.env` in the same directory and fill in the real values.
# `.env` is covered by the repo's .gitignore and must never be committed.

# Supabase project URL, e.g. https://elebuieojodsjmghwjub.supabase.co
SUPABASE_URL=

# Dashboard -> Project Settings -> API -> `service_role` (the SECRET key, not `anon`).
# This key bypasses row-level security completely. It stays on this machine.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to start with every write path disabled.
ADMIN_READONLY=0

# Port for the local server. Bound to 127.0.0.1 only.
ADMIN_PORT=8787
