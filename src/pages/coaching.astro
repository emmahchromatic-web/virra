---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { client, urlFor } from '../lib/sanity';
import { COACHING_QUERY } from '../lib/queries';

const coaching = await client.fetch(COACHING_QUERY).catch(() => null);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const mini = coaching?.miniAbout;
const quote = coaching?.motivationalQuote;
const cta = coaching?.ctaBlock;

const faqSchema = coaching?.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: coaching.faq.map((item: any) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---
<BaseLayout
  title="1:1 Coaching — VIRRA"
  description="Bespoke 1:1 coaching for women runners. Cycle-aware training, nutrition and real accountability. Enquire for a free consultation with Emma."
>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <Header />
  <main>

    <!-- BLOCK 1 — HERO & ENQUIRY FORM -->
    <section class="c-hero">
      <div class="wrap hero-grid">
        <div class="hero-media">
          {coaching?.heroImage
            ? <img src={urlFor(coaching.heroImage).width(760).height(1000).url()} alt="Emma, VIRRA running coach" width="760" height="1000" loading="eager" />
            : <div class="hero-placeholder" aria-hidden="true" />
          }
        </div>

        <div class="hero-main">
          <div class="hero-copy">
            <SectionLabel text="1:1 Coaching with Emma" />
            <h1>Train with purpose.</h1>
            {coaching?.heroTagline && <p class="c-tagline">{coaching.heroTagline}</p>}
            {coaching?.heroIntro && <p class="hero-intro">{coaching.heroIntro}</p>}
            {coaching?.whoItsFor?.length > 0 && (
              <ul class="who-list">
                {coaching.whoItsFor.map((item: string) => <li>{item}</li>)}
              </ul>
            )}
          </div>

          <div class="hero-form" id="enquire">
          <p class="form-eyebrow">Enquire</p>
          <p class="form-lead">Fill in the form and Emma will be in touch within 48 hours.</p>
          <form class="enq-form" id="enq-form">
            <input type="text" name="_hp" style="display:none" tabindex="-1" autocomplete="off" />
            <div class="field-row">
              <label>
                <span>Full name *</span>
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label>
                <span>Email *</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
            </div>
            <div class="field-row">
              <label>
                <span>How can VIRRA help you? *</span>
                <select name="helpWith" required>
                  <option value="">Select...</option>
                  <option>Lose weight / lean up</option>
                  <option>Build strength</option>
                  <option>Race prep</option>
                  <option>Train with my cycle</option>
                  <option>Not sure yet</option>
                </select>
              </label>
              <label>
                <span>Current running level *</span>
                <select name="level" required>
                  <option value="">Select...</option>
                  <option>Complete beginner</option>
                  <option>Recreational (occasional 5K–10K)</option>
                  <option>Intermediate (half marathon / consistent training)</option>
                  <option>Advanced (marathon / competitive)</option>
                </select>
              </label>
            </div>
            <label class="full">
              <span>Your goal *</span>
              <textarea name="goal" required rows="3" placeholder="e.g. Run my first half marathon in under 2 hours by October"></textarea>
            </label>
            <div class="field-row">
              <label>
                <span>Preferred start month</span>
                <input type="text" name="startMonth" placeholder="e.g. July 2026" />
              </label>
              <label>
                <span>How did you hear about VIRRA?</span>
                <input type="text" name="referral" />
              </label>
            </div>
            <label class="checkbox-label">
              <input type="checkbox" name="newsletter" />
              <span>Subscribe me to Run Hot (the VIRRA newsletter)</span>
            </label>
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
            <button type="submit" class="submit-btn">Send enquiry</button>
          </form>
          <p class="enq-ok" id="enq-ok" role="status" hidden>Thanks. Emma will be in touch within 48 hours.</p>
          <p class="enq-err" id="enq-err" role="alert" hidden>Something went wrong. Email <a href="mailto:hello@virra.app">hello@virra.app</a> directly.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 2 — TESTIMONIALS -->
    {coaching?.testimonials?.length > 0 && (
      <section class="testimonials">
        <div class="wrap">
          <SectionLabel text="What clients say" as="h2" />
          <div class="testi-grid">
            {coaching.testimonials.map((t: any) => (
              <div class="testi-card">
                <p class="testi-quote">“{t.quote}”</p>
                <span class="testi-name">— {t.name}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- BLOCK 3 — MINI ABOUT EMMA -->
    {mini && (mini.heading || mini.body) && (
      <section class="mini-about">
        <div class:list={['wrap', 'mini-grid', { 'no-img': !mini.image }]}>
          {mini.image && (
            <div class="mini-img">
              <img src={urlFor(mini.image).width(440).height(550).url()} alt={mini.heading || 'Emma'} width="440" height="550" loading="lazy" />
            </div>
          )}
          <div class="mini-copy">
            <SectionLabel text="Your coach" />
            {mini.heading && <h2>{mini.heading}</h2>}
            {mini.body && <p class="mini-body">{mini.body}</p>}
            <a href="/about" class="mini-link">Read Emma's full story →</a>
          </div>
        </div>
      </section>
    )}

    <!-- BLOCK 4 — MOTIVATIONAL QUOTE -->
    {quote?.quote && (
      <section class="quote-block">
        <div class="wrap">
          <h2 class="visually-hidden">In her words</h2>
          <blockquote>
            <p>“{quote.quote}”</p>
            {quote.attribution && <cite>{quote.attribution}</cite>}
          </blockquote>
        </div>
      </section>
    )}

    <!-- BLOCK 5 — WHAT'S INCLUDED -->
    {coaching?.whatsIncluded?.length > 0 && (
      <section class="included">
        <div class="wrap">
          <SectionLabel text="What's included" as="h2" />
          {coaching.whatsIncludedIntro && <p class="included-intro">{coaching.whatsIncludedIntro}</p>}
          <div class="included-grid">
            {coaching.whatsIncluded.map((item: any) => (
              <div class="included-item">
                <h3>{item.title}</h3>
                {item.description && <p>{item.description}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- BLOCK 6 — FAQ -->
    {coaching?.faq?.length > 0 && (
      <section class="faq">
        <div class="wrap">
          <SectionLabel text="FAQ" as="h2" />
          <div class="faq-list">
            {coaching.faq.map((item: any) => (
              <details class="faq-item">
                <summary class="faq-q">{item.question}</summary>
                <p class="faq-a">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- BLOCK 7 — CLOSING CTA -->
    <section class="cta-block">
      <div class="wrap">
        <h2>{cta?.heading ?? 'Ready to train with intent?'}</h2>
        {(cta?.body ?? "Tell Emma your goal and she'll be in touch within 48 hours. No pressure, no shame culture.") && (
          <p class="cta-body">{cta?.body ?? "Tell Emma your goal and she'll be in touch within 48 hours. No pressure, no shame culture."}</p>
        )}
        <a href="#enquire" class="cta-btn">{cta?.buttonLabel ?? 'Start your enquiry'}</a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  import { track } from '@vercel/analytics';
  const form = document.getElementById('enq-form') as HTMLFormElement;
  const ok = document.getElementById('enq-ok') as HTMLElement;
  const err = document.getElementById('enq-err') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    const fd = new FormData(form);
    const payload = {
      _hp: fd.get('_hp'),
      cfToken: fd.get('cf-turnstile-response'),
      name: fd.get('name'),
      email: fd.get('email'),
      helpWith: fd.get('helpWith'),
      level: fd.get('level'),
      goal: fd.get('goal'),
      startMonth: fd.get('startMonth'),
      referral: fd.get('referral'),
      newsletter: fd.get('newsletter') === 'on',
    };

    const res = await fetch('/api/coaching-enquiry', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      track('coaching-enquiry');
      form.hidden = true;
      ok.hidden = false;
    } else {
      btn.disabled = false;
      btn.textContent = 'Send enquiry';
      err.hidden = false;
    }
  });
</script>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 48px; }

  /* BLOCK 1 — HERO & FORM */
  .c-hero { padding: 90px 0 70px; }
  .hero-grid { display: grid; grid-template-columns: minmax(280px, 440px) 1fr; gap: 48px; align-items: stretch; }

  /* Column 1 — welcoming hero image (fills the column height alongside the form) */
  .hero-media { position: relative; border-radius: 2px; overflow: hidden; min-height: 460px; }
  .hero-media img, .hero-media .hero-placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-placeholder { background: var(--mist); }

  /* Column 2 — copy stacked above the enquiry form */
  .hero-main { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .c-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.86;
    color: var(--breath);
    margin: 12px 0 20px;
  }
  .c-tagline {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    color: rgba(244,237,224,0.72);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 24px;
  }
  .hero-intro { font-size: 1rem; line-height: 1.7; color: rgba(244,237,224,0.75); margin-bottom: 24px; max-width: 46ch; }
  .who-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .who-list li {
    font-size: 0.95rem;
    color: rgba(244,237,224,0.82);
    padding-left: 22px;
    position: relative;
    line-height: 1.5;
  }
  .who-list li::before { content: '—'; position: absolute; left: 0; color: var(--pulse); }

  /* Enquiry form card */
  .hero-form {
    background: var(--mist);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    padding: 32px;
    scroll-margin-top: 90px;
  }
  .form-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--heat);
    margin-bottom: 8px;
  }
  .form-lead { font-size: 0.92rem; line-height: 1.5; color: rgba(244,237,224,0.72); margin-bottom: 20px; }
  .enq-form { display: flex; flex-direction: column; gap: 14px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  label span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  input[type=text], input[type=email], select, textarea {
    width: 100%;
    background: rgba(244,237,224,0.03);
    border: 1px solid var(--border-strong);
    color: var(--breath);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 300;
    padding: 11px 14px;
    border-radius: 2px;
    transition: border-color 0.2s;
    line-height: 1.4;
    box-sizing: border-box;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--pulse); }
  select {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding-right: 40px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1.5L6 6.5L11 1.5' stroke='%23F4EDE0' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
  }
  textarea { resize: vertical; }
  label.full { display: flex; flex-direction: column; }
  .checkbox-label { display: flex; align-items: center; gap: 10px; cursor: pointer; }
  .checkbox-label input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--pulse); flex-shrink: 0; }
  .checkbox-label span {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: rgba(244,237,224,0.75);
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: 0;
  }
  .submit-btn {
    align-self: flex-start;
    background: var(--pulse);
    color: var(--mile);
    border: none;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 15px 30px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .submit-btn:hover { background: #c8f020; }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .enq-ok { color: var(--pulse); font-size: 1rem; margin-top: 16px; }
  .enq-err { color: var(--dawn); font-size: 0.9rem; margin-top: 16px; }
  .enq-err a { color: var(--dawn); }

  /* BLOCK 2 — TESTIMONIALS */
  .testimonials { padding: 70px 0; border-top: 1px solid var(--border); }
  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 24px; }
  .testi-card { background: var(--mist); border: 1px solid var(--border); padding: 28px 24px; border-radius: 2px; }
  .testi-quote {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--breath);
    margin-bottom: 16px;
  }
  .testi-name { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }

  /* BLOCK 3 — MINI ABOUT */
  .mini-about { padding: 70px 0; border-top: 1px solid var(--border); }
  .mini-grid { display: grid; grid-template-columns: 300px 1fr; gap: 56px; align-items: center; }
  .mini-grid.no-img { grid-template-columns: 1fr; max-width: 720px; }
  .mini-img img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 2px; display: block; }
  .mini-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: var(--breath);
    margin: 6px 0 18px;
  }
  .mini-body { font-size: 1rem; line-height: 1.75; color: rgba(244,237,224,0.75); margin-bottom: 20px; white-space: pre-line; }
  .mini-link { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--pulse); text-decoration: none; }
  .mini-link:hover { text-decoration: underline; }

  /* BLOCK 4 — MOTIVATIONAL QUOTE */
  .quote-block { padding: 80px 0; border-top: 1px solid var(--border); }
  .quote-block blockquote { max-width: 900px; margin: 0 auto; text-align: center; }
  .quote-block blockquote p {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--breath);
  }
  .quote-block cite {
    display: block;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--heat);
  }

  /* BLOCK 5 — WHAT'S INCLUDED */
  .included { padding: 70px 0; border-top: 1px solid var(--border); }
  .included-intro { font-size: 1rem; line-height: 1.7; color: rgba(244,237,224,0.75); margin-top: 8px; max-width: 60ch; }
  .included-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 28px; }
  .included-item { background: var(--mist); border: 1px solid var(--border); padding: 26px 24px; border-radius: 2px; }
  .included-item h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--pulse);
    margin-bottom: 10px;
  }
  .included-item p { font-size: 0.92rem; line-height: 1.6; color: rgba(244,237,224,0.75); }

  /* BLOCK 6 — FAQ */
  .faq { padding: 70px 0; border-top: 1px solid var(--border); }
  .faq-list { margin-top: 24px; display: flex; flex-direction: column; gap: 2px; }
  .faq-item { border: 1px solid var(--border); border-radius: 2px; }
  .faq-q {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--breath);
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-q::after { content: '+'; color: var(--pulse); font-family: var(--font-body); font-weight: 300; font-size: 1.4rem; }
  .faq-item[open] .faq-q::after { content: '−'; }
  .faq-a { padding: 0 20px 18px; font-size: 0.95rem; line-height: 1.7; color: rgba(244,237,224,0.75); }

  /* BLOCK 7 — CLOSING CTA */
  .cta-block { padding: 80px 0; border-top: 1px solid var(--border); background: var(--mist); text-align: center; }
  .cta-block h2 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.88;
    color: var(--breath);
    margin-bottom: 18px;
  }
  .cta-body { font-size: 1.05rem; line-height: 1.6; color: rgba(244,237,224,0.75); margin: 0 auto 30px; max-width: 52ch; }
  .cta-btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--pulse);
    color: var(--mile);
    padding: 16px 36px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cta-btn:hover { background: #c8f020; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .hero-media { min-height: 0; aspect-ratio: 3 / 2; }
    .mini-grid { grid-template-columns: 1fr; gap: 28px; }
    .mini-img img { max-width: 260px; }
  }
  @media (max-width: 768px) {
    .c-hero { padding: 56px 0; }
    .testimonials, .mini-about, .included, .faq { padding: 56px 0; }
    .quote-block, .cta-block { padding: 56px 0; }
    .testi-grid, .included-grid { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .wrap { padding: 0 24px; }
    .hero-form { padding: 24px; }
  }
</style>
