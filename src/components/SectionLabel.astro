---
// Small mono kicker/eyebrow. Pass `as="h2"` when this label is the section's
// heading (keeps the document outline correct — see WCAG heading-order work);
// leave as the default <p> when a separate display heading already sits in the
// section (e.g. a big <h2> title beneath the kicker).
interface Props { text: string; as?: 'p' | 'h2'; }
const { text, as = 'p' } = Astro.props;
const Tag = as;
---
<Tag class="section-label">{text}</Tag>
<style>
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--heat);
    margin-bottom: 10px;
    font-weight: 400;
  }
</style>
