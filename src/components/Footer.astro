---
import { client } from '../lib/sanity';
import { SITE_SETTINGS_QUERY } from '../lib/queries';

const settings = await client.fetch(SITE_SETTINGS_QUERY).catch(() => null);
const year = new Date().getFullYear();

// Hardcoded fallbacks so the footer never blanks if the CMS is empty or unreachable —
// it renders on every page, so a failed fetch must degrade gracefully.
const legalLinks = settings?.legalLinks?.length ? settings.legalLinks : [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Cookie Policy', href: '/cookies' },
  { label: 'Contact', href: '/contact' },
];
const instagramHandle = settings?.instagramHandle || '@virrarun';
const instagramUrl = settings?.instagramUrl || 'https://instagram.com/virrarun';
const copyrightName = settings?.copyrightName || 'VIRRA';
---
<footer class="site-footer">
  <div class="f-inner">
    <div class="f-bottom">
      <div class="f-links">
        {legalLinks.map((link: { label: string; href: string }) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
      <div class="f-meta">
        <a class="f-social" href={instagramUrl} target="_blank" rel="noopener noreferrer">{instagramHandle}</a>
        <span class="f-copy">&copy; {copyrightName} {year}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 40px;
  }
  .f-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .f-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .f-links a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: normal;
    text-transform: none;
    color: rgba(244, 237, 224, 0.7);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .f-links a:hover { color: var(--pulse); }
  .f-links a:focus-visible,
  .f-social:focus-visible {
    outline: 2px solid var(--heat);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .f-meta {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .f-social {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .f-social:hover { color: var(--breath); }
  .f-copy {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .f-inner { padding: 0 24px; }
    .f-bottom { flex-direction: column; align-items: flex-start; }
    .f-meta { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
